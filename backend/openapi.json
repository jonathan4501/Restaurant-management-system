components:
  schemas:
    AddItemInputRequest:
      type: object
      properties:
        id:
          type: string
          format: uuid
        menu_item_id:
          type: string
          format: uuid
        quantity:
          type: integer
          minimum: 1
        modifier_ids:
          type: array
          items:
            type: string
            format: uuid
        notes:
          type: string
          default: ''
          maxLength: 500
        course:
          type: integer
          minimum: 1
          default: 1
      required:
      - id
      - menu_item_id
      - quantity
    AuthoriseInputRequest:
      type: object
      properties:
        pin:
          type: string
          minLength: 4
          maxLength: 6
        purpose:
          enum:
          - VOID_AFTER_ACK
          - DISCOUNT
          - COMP
          - PRICE_OVERRIDE
          - REOPEN
          - DRAWER_MOVEMENT
          - PAYMENT_VOID
          - PRICE_CHANGE_IN_SERVICE
          type: string
          description: |-
            * `VOID_AFTER_ACK` - VOID_AFTER_ACK
            * `DISCOUNT` - DISCOUNT
            * `COMP` - COMP
            * `PRICE_OVERRIDE` - PRICE_OVERRIDE
            * `REOPEN` - REOPEN
            * `DRAWER_MOVEMENT` - DRAWER_MOVEMENT
            * `PAYMENT_VOID` - PAYMENT_VOID
            * `PRICE_CHANGE_IN_SERVICE` - PRICE_CHANGE_IN_SERVICE
          x-spec-enum-id: 76e0ccf71c541d93
      required:
      - pin
      - purpose
    BestSeller:
      type: object
      properties:
        name:
          type: string
          description: The name snapshotted onto the line when it was ordered.
        quantity:
          type: integer
        value_pesewas:
          type: integer
          description: Σ line totals. Integer pesewas.
      required:
      - name
      - quantity
      - value_pesewas
    CloseShiftInputRequest:
      type: object
      properties:
        declared_cash_pesewas:
          type: integer
          minimum: 0
        note:
          type: string
          default: ''
          maxLength: 500
      required:
      - declared_cash_pesewas
    CompInputRequest:
      type: object
      properties:
        reason_code:
          type: string
          minLength: 1
          maxLength: 64
        note:
          type: string
          default: ''
          maxLength: 500
    DiscountInputRequest:
      type: object
      properties:
        kind:
          enum:
          - PERCENT
          - AMOUNT
          type: string
          description: |-
            * `PERCENT` - PERCENT
            * `AMOUNT` - AMOUNT
          x-spec-enum-id: 9f25e7b70bb7b01c
        value:
          type: integer
          minimum: 0
        reason_code:
          type: string
          minLength: 1
          maxLength: 64
        note:
          type: string
          default: ''
          maxLength: 500
      required:
      - kind
      - value
    DiscountsByStaff:
      type: object
      properties:
        staff:
          type: string
        staff_id:
          type: string
          format: uuid
          nullable: true
        discount_count:
          type: integer
        discount_pesewas:
          type: integer
          description: Integer pesewas.
        comp_count:
          type: integer
        comp_pesewas:
          type: integer
          description: Integer pesewas.
        value_pesewas:
          type: integer
          description: Discounts and comps together. Integer pesewas.
      required:
      - comp_count
      - comp_pesewas
      - discount_count
      - discount_pesewas
      - staff
      - staff_id
      - value_pesewas
    DrawerMovementInputRequest:
      type: object
      properties:
        kind:
          enum:
          - NO_SALE
          - PAID_OUT
          - PAID_IN
          type: string
          description: |-
            * `NO_SALE` - No Sale
            * `PAID_OUT` - Paid Out
            * `PAID_IN` - Paid In
          x-spec-enum-id: 560f8a95c18eda11
        amount_pesewas:
          type: integer
          minimum: 0
          default: 0
        reason_code:
          type: string
          minLength: 1
          maxLength: 64
        note:
          type: string
          default: ''
          maxLength: 500
      required:
      - kind
    EnrolDeviceInputRequest:
      type: object
      properties:
        enrolment_code:
          type: string
          minLength: 1
          maxLength: 16
      required:
      - enrolment_code
    EventLog:
      type: object
      properties:
        events:
          type: array
          items:
            $ref: '#/components/schemas/EventLogRow'
        next_cursor:
          type: integer
          nullable: true
          description: Pass as `cursor` for the next page. Null on the last page.
        has_more:
          type: boolean
      required:
      - events
      - has_more
      - next_cursor
    EventLogRow:
      type: object
      properties:
        seq:
          type: integer
          description: Per restaurant, gapless. Cursor for the next page.
        type:
          type: string
        aggregate_type:
          type: string
        aggregate_id:
          type: string
          format: uuid
        order_id:
          type: string
          format: uuid
          nullable: true
        actor_id:
          type: string
          format: uuid
          nullable: true
        actor:
          type: string
          nullable: true
        actor_role:
          type: string
        authorised_by:
          type: string
          nullable: true
          description: The manager who authorised the override, where there was one.
        reason_code:
          type: string
          nullable: true
        flagged:
          type: boolean
          description: Rendered distinctly in the owner's log. Derived from the event
            type, never stored; a void counts only once the kitchen has acknowledged
            the order.
        created_at:
          type: string
          format: date-time
          description: Server time. Authoritative.
        payload:
          type: object
          additionalProperties: {}
      required:
      - actor
      - actor_id
      - actor_role
      - aggregate_id
      - aggregate_type
      - authorised_by
      - created_at
      - flagged
      - order_id
      - payload
      - reason_code
      - seq
      - type
    GuestTokenInputRequest:
      type: object
      properties:
        mode:
          enum:
          - guest
          type: string
          description: '* `guest` - guest'
          x-spec-enum-id: b378d01057432846
          default: guest
    HourlyMoney:
      type: object
      properties:
        hour:
          type: integer
          description: Hour 0–23 in the restaurant's own timezone.
        money_taken_pesewas:
          type: integer
          description: Money taken (gross cash through the till). Integer pesewas.
            Not revenue, not profit.
      required:
      - hour
      - money_taken_pesewas
    ModifyItemInputRequest:
      type: object
      properties:
        quantity:
          type: integer
          minimum: 1
        modifier_ids:
          type: array
          items:
            type: string
            format: uuid
        notes:
          type: string
          maxLength: 500
        course:
          type: integer
          minimum: 1
    OpenOrderInputRequest:
      type: object
      properties:
        id:
          type: string
          format: uuid
        session_id:
          type: string
          format: uuid
      required:
      - id
      - session_id
    OpenSessionInputRequest:
      type: object
      properties:
        id:
          type: string
          format: uuid
        table_id:
          type: string
          format: uuid
        party_size:
          type: integer
          minimum: 1
          nullable: true
      required:
      - id
      - table_id
    OpenShiftInputRequest:
      type: object
      properties:
        id:
          type: string
          format: uuid
        opening_float_pesewas:
          type: integer
          minimum: 0
      required:
      - id
      - opening_float_pesewas
    OrderNumberGap:
      type: object
      properties:
        business_date:
          type: string
          format: date
        missing:
          type: array
          items:
            type: integer
          description: Ticket numbers that were issued but are not in the projections.
      required:
      - business_date
      - missing
    Patterns:
      type: object
      properties:
        date_from:
          type: string
          format: date
        date_to:
          type: string
          format: date
        money_taken_pesewas:
          type: integer
          description: Money taken (gross cash through the till). Integer pesewas.
            Not revenue, not profit.
        money_taken_by_hour:
          type: array
          items:
            $ref: '#/components/schemas/HourlyMoney'
        payment_method_mix:
          type: object
          additionalProperties:
            type: integer
          description: Payment method → money taken. Integer pesewas.
        best_sellers_by_value:
          type: array
          items:
            $ref: '#/components/schemas/BestSeller'
        station_timing:
          type: array
          items:
            $ref: '#/components/schemas/StationTiming'
      required:
      - best_sellers_by_value
      - date_from
      - date_to
      - money_taken_by_hour
      - money_taken_pesewas
      - payment_method_mix
      - station_timing
    PinLoginInputRequest:
      type: object
      properties:
        staff_id:
          type: string
          format: uuid
        pin:
          type: string
          minLength: 4
          maxLength: 6
      required:
      - pin
      - staff_id
    PriceChangeInputRequest:
      type: object
      properties:
        price_pesewas:
          type: integer
          minimum: 0
      required:
      - price_pesewas
    PriceOverrideInputRequest:
      type: object
      properties:
        unit_price_pesewas:
          type: integer
          minimum: 0
        reason_code:
          type: string
          minLength: 1
          maxLength: 64
        note:
          type: string
          default: ''
          maxLength: 500
      required:
      - unit_price_pesewas
    RecordPaymentInputRequest:
      type: object
      properties:
        id:
          type: string
          format: uuid
        method:
          enum:
          - CASH
          - MOMO_MTN
          - MOMO_TELECEL
          - MOMO_AT
          - CARD
          - BANK
          type: string
          description: |-
            * `CASH` - Cash
            * `MOMO_MTN` - Momo Mtn
            * `MOMO_TELECEL` - Momo Telecel
            * `MOMO_AT` - Momo At
            * `CARD` - Card
            * `BANK` - Bank
          x-spec-enum-id: a4203ecf9f4e5aef
        amount_pesewas:
          type: integer
          minimum: 1
        tendered_pesewas:
          type: integer
          minimum: 0
          nullable: true
        external_reference:
          type: string
          nullable: true
          maxLength: 64
        order_id:
          type: string
          format: uuid
          nullable: true
      required:
      - amount_pesewas
      - id
      - method
    ReopenSessionInputRequest:
      type: object
      properties:
        reason_code:
          type: string
          minLength: 1
          maxLength: 64
        note:
          type: string
          default: ''
          maxLength: 500
    ReopenedBill:
      type: object
      properties:
        session_id:
          type: string
          format: uuid
        table_number:
          type: string
          nullable: true
        trigger:
          enum:
          - MANAGER
          - PAYMENT_VOID
          type: string
          x-spec-enum-id: 8d17ca96d3880f3f
          description: |-
            MANAGER: someone reopened the bill on purpose. PAYMENT_VOID: voiding a payment took a settled bill back below its total.

            * `MANAGER` - MANAGER
            * `PAYMENT_VOID` - PAYMENT_VOID
        orders_reopened:
          type: integer
        reason_code:
          type: string
          nullable: true
        actor:
          type: string
          nullable: true
        authorised_by:
          type: string
          nullable: true
        at:
          type: string
          format: date-time
      required:
      - actor
      - at
      - authorised_by
      - orders_reopened
      - reason_code
      - session_id
      - table_number
      - trigger
    RequestReceiptInputRequest:
      type: object
      properties:
        session_id:
          type: string
          format: uuid
          description: The bill to print a sales record for.
      required:
      - session_id
    ShiftVariance:
      type: object
      properties:
        shift_id:
          type: string
          format: uuid
        cashier:
          type: string
        cashier_id:
          type: string
          format: uuid
        opened_at:
          type: string
          format: date-time
        closed_at:
          type: string
          format: date-time
          nullable: true
        expected_cash_pesewas:
          type: integer
          nullable: true
          description: Integer pesewas.
        declared_cash_pesewas:
          type: integer
          nullable: true
          description: What the cashier counted. Integer pesewas.
        variance_pesewas:
          type: integer
          nullable: true
          description: Declared − expected. Negative is a short count. Integer pesewas.
      required:
      - cashier
      - cashier_id
      - closed_at
      - declared_cash_pesewas
      - expected_cash_pesewas
      - opened_at
      - shift_id
      - variance_pesewas
    StationTiming:
      type: object
      properties:
        station:
          type: string
        average_seconds:
          type: integer
          description: Acknowledged → ready, mean over the window.
        lines:
          type: integer
      required:
      - average_seconds
      - lines
      - station
    Today:
      type: object
      description: The service so far, live from the projections. Today is not rolled
        up until after cutover.
      properties:
        business_date:
          type: string
          format: date
        money_taken_pesewas:
          type: integer
          description: Money taken (gross cash through the till). Integer pesewas.
            Not revenue, not profit.
        covers:
          type: integer
          description: Σ party size of the bills settled today.
        bills_settled:
          type: integer
        average_bill_pesewas:
          type: integer
          description: Money taken ÷ bills settled, integer pesewas, floored. Never
            a float.
        open_bills:
          type: integer
          description: Bills still owing money right now.
        open_balance_pesewas:
          type: integer
          description: Still to be collected on open bills. Integer pesewas.
        orders_closed:
          type: integer
      required:
      - average_bill_pesewas
      - bills_settled
      - business_date
      - covers
      - money_taken_pesewas
      - open_balance_pesewas
      - open_bills
      - orders_closed
    Variance:
      type: object
      description: Every way money can leave without a sale behind it.
      properties:
        date_from:
          type: string
          format: date
        date_to:
          type: string
          format: date
        voids_after_acknowledgement:
          type: array
          items:
            $ref: '#/components/schemas/VoidAfterAck'
        void_value_pesewas:
          type: integer
          description: Food that was cooked and thrown away. Integer pesewas.
        discounts_by_staff:
          type: array
          items:
            $ref: '#/components/schemas/DiscountsByStaff'
        discount_pesewas:
          type: integer
          description: Integer pesewas.
        comp_pesewas:
          type: integer
          description: Integer pesewas.
        reopened_bills:
          type: array
          items:
            $ref: '#/components/schemas/ReopenedBill'
        reopened_count:
          type: integer
        manager_reopens:
          type: integer
          description: Of those, the ones a manager reopened deliberately.
        cash_variance_by_shift:
          type: array
          items:
            $ref: '#/components/schemas/ShiftVariance'
        cash_variance_pesewas:
          type: integer
          description: Integer pesewas.
        order_number_gaps:
          type: array
          items:
            $ref: '#/components/schemas/OrderNumberGap'
      required:
      - cash_variance_by_shift
      - cash_variance_pesewas
      - comp_pesewas
      - date_from
      - date_to
      - discount_pesewas
      - discounts_by_staff
      - manager_reopens
      - order_number_gaps
      - reopened_bills
      - reopened_count
      - void_value_pesewas
      - voids_after_acknowledgement
    VoidAfterAck:
      type: object
      properties:
        order_id:
          type: string
          format: uuid
          nullable: true
        order_number:
          type: integer
          nullable: true
        table_number:
          type: string
          nullable: true
        value_pesewas:
          type: integer
          description: Order total when the void was authorised. Integer pesewas.
        status_at_void:
          type: string
          nullable: true
        reason_code:
          type: string
          nullable: true
        actor:
          type: string
          nullable: true
          description: Who voided it.
        actor_role:
          type: string
          nullable: true
        authorised_by:
          type: string
          nullable: true
          description: The manager whose PIN allowed it.
        at:

  /api/v1/devices/me:
    get:
      operationId: devices_me_retrieve
      description: |-
        GET /devices/me — device label, roles, staff list for the PIN pad.

        Answers to the device token alone: the PIN pad needs the staff list before anyone has signed in.
        A staff bearer, if sent, must still be valid (a revoked or foreign token is 401). Guests are 403.
      tags:
      - devices
      security:
      - bearerAuth: []
      - {}
      responses:
        '200':
          description: No response body
      parameters:
      - name: X-Device-Token
        in: header
        required: false
        description: Enrolled device token. Required for every staff request.
        schema:
          type: string
  /api/v1/events:
    get:
      operationId: events_retrieve
      description: '`last_seq` is the highest seq scanned, including events this role
        may not see — always send it back as `since`. `has_more` means call again
        immediately.'
      summary: Poll events (SSE fallback)
      parameters:
      - in: query
        name: limit
        schema:
          type: integer
        description: Max events scanned (default 200, max 1000).
      - in: query
        name: since
        schema:
          type: integer
        description: Last seq seen. Returns events with seq > since.
      - name: X-Device-Token
        in: header
        required: false
        description: Enrolled device token. Required for every staff request.
        schema:
          type: string
      tags:
      - events
      security:
      - bearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                type: object
                additionalProperties: {}
          description: ''
  /api/v1/events/log:
    get:
      operationId: events_log
      description: The full event stream for the restaurant. `flagged` is derived
        from the event type (and, for voids, whether the kitchen had acknowledged)
        — never stored.
      parameters:
      - in: query
        name: actor_id
        schema:
          type: string
          format: uuid
      - in: query
        name: aggregate_type
        schema:
          type: string
      - in: query
        name: cursor
        schema:
          type: integer
          format: int64
        description: '`next_cursor` from the previous page. Pages run newest first.'
      - in: query
        name: flagged
        schema:
          type: boolean
        description: Only the actions the owner is asked to look at.
      - in: query
        name: from
        schema:
          type: string
          format: date-time
        description: Server time, inclusive (ISO 8601).
      - in: query
        name: limit
        schema:
          type: integer
        description: Rows per page (1–200, default 100).
      - in: query
        name: to
        schema:
          type: string
          format: date-time
        description: Server time, exclusive (ISO 8601).
      - in: query
        name: type
        schema:
          type: string
        description: One event type.
      - name: X-Device-Token
        in: header
        required: false
        description: Enrolled device token. Required for every staff request.
        schema:
          type: string
      tags:
      - events
      security:
      - bearerAuth: []
      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/EventLog'
          description: ''

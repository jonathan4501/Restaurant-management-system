components:
  schemas:
    AddItemInputRequest:
      type: object
      properties:
        id:
          type: string
          format: uuid
        menu_item_id:
          type: string
          format: uuid
        quantity:
          type: integer
          minimum: 1
        modifier_ids:
          type: array
          items:
            type: string
            format: uuid
        notes:
          type: string
          default: ''
          maxLength: 500
        course:
          type: integer
          minimum: 1
          default: 1
      required:
      - id
      - menu_item_id
      - quantity
    AuthoriseInputRequest:
      type: object
      properties:
        pin:
          type: string
          minLength: 4
          maxLength: 6
        purpose:
          enum:
          - VOID_AFTER_ACK
          - DISCOUNT
          - COMP
          - PRICE_OVERRIDE
          - REOPEN
          - DRAWER_MOVEMENT
          - PAYMENT_VOID
          - PRICE_CHANGE_IN_SERVICE
          type: string
          description: |-
            * `VOID_AFTER_ACK` - VOID_AFTER_ACK
            * `DISCOUNT` - DISCOUNT
            * `COMP` - COMP
            * `PRICE_OVERRIDE` - PRICE_OVERRIDE
            * `REOPEN` - REOPEN
            * `DRAWER_MOVEMENT` - DRAWER_MOVEMENT
            * `PAYMENT_VOID` - PAYMENT_VOID
            * `PRICE_CHANGE_IN_SERVICE` - PRICE_CHANGE_IN_SERVICE
          x-spec-enum-id: 76e0ccf71c541d93
      required:
      - pin
      - purpose
    CloseShiftInputRequest:
      type: object
      properties:
        declared_cash_pesewas:
          type: integer
          minimum: 0
        note:
          type: string
          default: ''
          maxLength: 500
      required:
      - declared_cash_pesewas
    CompInputRequest:
      type: object
      properties:
        reason_code:
          type: string
          minLength: 1
          maxLength: 64
        note:
          type: string
          default: ''
          maxLength: 500
    DiscountInputRequest:
      type: object
      properties:
        kind:
          enum:
          - PERCENT
          - AMOUNT
          type: string
          description: |-
            * `PERCENT` - PERCENT
            * `AMOUNT` - AMOUNT
          x-spec-enum-id: 9f25e7b70bb7b01c
        value:
          type: integer
          minimum: 0
        reason_code:
          type: string
          minLength: 1
          maxLength: 64
        note:
          type: string
          default: ''
          maxLength: 500
      required:
      - kind
      - value
    DrawerMovementInputRequest:
      type: object
      properties:
        kind:
          enum:
          - NO_SALE
          - PAID_OUT
          - PAID_IN
          type: string
          description: |-
            * `NO_SALE` - No Sale
            * `PAID_OUT` - Paid Out
            * `PAID_IN` - Paid In
          x-spec-enum-id: 560f8a95c18eda11
        amount_pesewas:
          type: integer
          minimum: 0
          default: 0
        reason_code:
          type: string
          minLength: 1
          maxLength: 64
        note:
          type: string
          default: ''
          maxLength: 500
      required:
      - kind
    EnrolDeviceInputRequest:
      type: object
      properties:
        enrolment_code:
          type: string
          minLength: 1
          maxLength: 16
      required:
      - enrolment_code
    GuestTokenInputRequest:
      type: object
      properties:
        mode:
          enum:
          - guest
          type: string
          description: '* `guest` - guest'
          x-spec-enum-id: b378d01057432846
          default: guest
    ModifyItemInputRequest:
      type: object
      properties:
        quantity:
          type: integer
          minimum: 1
        modifier_ids:
          type: array
          items:
            type: string
            format: uuid
        notes:
          type: string
          maxLength: 500
        course:
          type: integer
          minimum: 1
    OpenOrderInputRequest:
      type: object
      properties:
        id:
          type: string
          format: uuid
        session_id:
          type: string
          format: uuid
      required:
      - id
      - session_id
    OpenSessionInputRequest:
      type: object
      properties:
        id:
          type: string
          format: uuid
        table_id:
          type: string
          format: uuid
        party_size:
          type: integer
          minimum: 1
          nullable: true
      required:
      - id
      - table_id
    OpenShiftInputRequest:
      type: object
      properties:
        id:
          type: string
          format: uuid
        opening_float_pesewas:
          type: integer
          minimum: 0
      required:
      - id
      - opening_float_pesewas
    PinLoginInputRequest:
      type: object
      properties:
        staff_id:
          type: string
          format: uuid
        pin:
          type: string
          minLength: 4
          maxLength: 6
      required:
      - pin
      - staff_id
    PriceChangeInputRequest:
      type: object
      properties:
        price_pesewas:
          type: integer
          minimum: 0
      required:
      - price_pesewas
    PriceOverrideInputRequest:
      type: object
      properties:
        unit_price_pesewas:
          type: integer
          minimum: 0
        reason_code:
          type: string
          minLength: 1
          maxLength: 64
        note:
          type: string
          default: ''
          maxLength: 500
      required:
      - unit_price_pesewas
    RecordPaymentInputRequest:
      type: object
      properties:
        id:
          type: string
          format: uuid
        method:
          enum:
          - CASH
          - MOMO_MTN
          - MOMO_TELECEL
          - MOMO_AT
          - CARD
          - BANK
          type: string
          description: |-
            * `CASH` - Cash
            * `MOMO_MTN` - Momo Mtn
            * `MOMO_TELECEL` - Momo Telecel
            * `MOMO_AT` - Momo At
            * `CARD` - Card
            * `BANK` - Bank
          x-spec-enum-id: a4203ecf9f4e5aef
        amount_pesewas:
          type: integer
          minimum: 1
        tendered_pesewas:
          type: integer
          minimum: 0
          nullable: true
        external_reference:
          type: string
          nullable: true
          maxLength: 64
        order_id:
          type: string
          format: uuid
          nullable: true
      required:
      - amount_pesewas
      - id
      - method
    ReopenSessionInputRequest:
      type: object
      properties:
        reason_code:
          type: string
          minLength: 1
          maxLength: 64
        note:
          type: string
          default: ''
          maxLength: 500
    RequestReceiptInputRequest:
      type: object
      properties:
        session_id:
          type: string
          format: uuid
          description: The bill to print a sales record for.
      required:
      - session_id
    VoidInputRequest:
      type: object
      properties:
        reason_code:
          type: string
          minLength: 1
          maxLength: 64
        note:
          type: string
          default: ''
          maxLength: 500
      required:
      - reason_code
    VoidPaymentInputRequest:
      type: object
      properties:
        reason_code:
          type: string
          minLength: 1
          maxLength: 64
        note:
          type: string
          default: ''
          maxLength: 500
  securitySchemes:
    bearerAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT
      description: Staff JWT (with X-Device-Token) or guest JWT. See docs/09-api-contract.md
        §1.

# Copy to infra/.env for production, or export in your shell for local dev.
# Dev defaults are baked into config/settings/dev.py, so local dev needs none of these.

# --- required in production ---
SECRET_KEY=change-me-64-random-chars
JWT_SIGNING_KEY=change-me-different-64-random-chars
DATABASE_URL=postgres://user:password@managed-host:5432/renzy?sslmode=require
REDIS_URL=redis://redis:6379/0
ALLOWED_HOSTS=api.renzy.example
CSRF_TRUSTED_ORIGINS=https://api.renzy.example
CORS_ALLOWED_ORIGINS=https://app.renzy.example
API_DOMAIN=api.renzy.example
IMAGE=ghcr.io/your-org/renzy-backend:sha

# --- observability ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
GIT_SHA=
LOG_LEVEL=INFO

# --- email (daily summary, reopen alerts) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=renzy@example.com
OWNER_ALERT_EMAIL=

# Copy to infra/.env for production. Dev defaults live in config/settings/dev.py.
# Never commit a filled-in copy. Secrets belong in the VPS env file and GitHub Actions secrets.

# --- required in production ---
SECRET_KEY=change-me-64-random-chars
JWT_SIGNING_KEY=change-me-different-64-random-chars
TOTP_ENCRYPTION_KEY=change-me-fernet-or-32-urlsafe-bytes
DATABASE_URL=postgres://app_user:change-me@managed-host:5432/renzy?sslmode=require
REDIS_URL=redis://redis:6379/0
ALLOWED_HOSTS=api.renzy.example
CSRF_TRUSTED_ORIGINS=https://api.renzy.example
CORS_ALLOWED_ORIGINS=https://app.renzy.example
API_DOMAIN=api.renzy.example
IMAGE=ghcr.io/your-org/restaurant-management-system/backend:sha
GIT_SHA=
CADDY_IMAGE=renzy-caddy:local

# Cloudflare DNS-01 for Caddy (optional if orange-cloud + origin cert)
CLOUDFLARE_API_TOKEN=

# --- observability ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Frontend (Vercel): also set NEXT_PUBLIC_SENTRY_DSN / SENTRY_AUTH_TOKEN in the Vercel project
LOG_LEVEL=INFO

# --- media on Cloudflare R2 (django-storages). Leave empty to keep local MEDIA_ROOT volume. ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=renzy-media
AWS_S3_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
AWS_S3_CUSTOM_DOMAIN=media.renzy.example
AWS_S3_REGION_NAME=auto

# --- backups (rclone → R2). Used by infra/scripts/backup-pg.sh and the restore-test workflow. ---
BACKUP_RCLONE_REMOTE=r2:renzy-backups
BACKUP_RETENTION_DAYS=30
# Restaurant id passed to verify_projections after a restore test
VERIFY_RESTAURANT_ID=

# --- email (daily summary, reopen alerts) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=renzy@example.com
OWNER_ALERT_EMAIL=

# GET /metrics (SSE connection gauge). Leave blank to disable the endpoint.
METRICS_TOKEN=

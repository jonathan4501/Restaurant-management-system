# Example env for the Next.js PWA (Vercel project settings or frontend/.env.local).
# The API + SSE stream stay on the VPS — never point NEXT_PUBLIC_API_URL at serverless for /stream.

NEXT_PUBLIC_API_URL=https://api.renzy.example
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_GIT_SHA=

# Build-time only (source maps). Leave blank in local dev.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
